<script>
//──────────────────────────────────────────────────────
//  OWL · No. I — single-voice instrument
//  one breath in, coupled multi-parameter out
//──────────────────────────────────────────────────────

const macros = { effort: 0.7, body: 0.5, tract: 0.5, drift: 0.4 };
let breath = 0;
let currentPitch = 174.61;       // F3
let voice = null;
let ctx, master;

const root = document.documentElement;
const breathBar = document.getElementById('breathBar');
const breathValueEl = document.getElementById('breathValue');
const breathFill = breathBar.querySelector('.breath-fill');

//──────────── audio setup ────────────
function ensureCtx() {
  if (ctx) return;
  ctx = new (window.AudioContext || window.webkitAudioContext)();
  master = ctx.createGain();
  master.gain.value = 0.45;
  // a gentle output filter to tame harshness
  const tone = ctx.createBiquadFilter();
  tone.type = 'highshelf';
  tone.frequency.value = 6000;
  tone.gain.value = -6;
  master.connect(tone);
  tone.connect(ctx.destination);
}

//──────────── voice ────────────
function startVoice() {
  ensureCtx();
  if (ctx.state === 'suspended') ctx.resume();
  if (voice) stopVoice(true);

  const t = ctx.currentTime;

  // — sources —
  const osc1 = ctx.createOscillator(); osc1.type = 'sine';
  const osc2 = ctx.createOscillator(); osc2.type = 'triangle';
  const noise = ctx.createBufferSource();

  // noise buffer (pink-ish)
  const buf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
  const data = buf.getChannelData(0);
  let last = 0;
  for (let i = 0; i < data.length; i++) {
    const white = Math.random() * 2 - 1;
    last = (last + 0.02 * white) / 1.02;
    data[i] = last * 3;
  }
  noise.buffer = buf;
  noise.loop = true;

  // — trill LFO (the warble) —
  const trill = ctx.createOscillator();
  trill.type = 'sine';
  trill.frequency.value = 14;
  const trillToPitch = ctx.createGain();
  trillToPitch.gain.value = 0;
  trill.connect(trillToPitch);
  trillToPitch.connect(osc1.frequency);
  trillToPitch.connect(osc2.frequency);

  // — trill -> amp wobble —
  const trillToAmp = ctx.createGain();
  trillToAmp.gain.value = 0;
  trill.connect(trillToAmp);

  // — amp envelope (controlled by breath) —
  const amp = ctx.createGain();
  amp.gain.value = 0;

  // — tremolo gain that the trill modulates —
  const trem = ctx.createGain();
  trem.gain.value = 1;
  trillToAmp.connect(trem.gain);

  // — formant filters (the tract) —
  const f1 = ctx.createBiquadFilter();
  f1.type = 'bandpass';
  f1.frequency.value = 700; f1.Q.value = 6;
  const f1g = ctx.createGain(); f1g.gain.value = 1.2;

  const f2 = ctx.createBiquadFilter();
  f2.type = 'bandpass';
  f2.frequency.value = 1800; f2.Q.value = 8;
  const f2g = ctx.createGain(); f2g.gain.value = 0.6;

  // — body lowpass —
  const body = ctx.createBiquadFilter();
  body.type = 'lowpass';
  body.frequency.value = 400; body.Q.value = 1.2;

  // — noise gain (breathiness) —
  const noiseGain = ctx.createGain();
  noiseGain.gain.value = 0;
  const noiseBP = ctx.createBiquadFilter();
  noiseBP.type = 'bandpass';
  noiseBP.frequency.value = 2000; noiseBP.Q.value = 2;

  // — wiring —
  osc1.connect(amp);
  osc2.connect(amp);
  amp.connect(trem);

  noise.connect(noiseBP); noiseBP.connect(noiseGain); noiseGain.connect(trem);

  trem.connect(body);
  body.connect(f1); body.connect(f2);
  f1.connect(f1g); f2.connect(f2g);
  f1g.connect(master); f2g.connect(master);

  // set base pitches (slight detune)
  osc1.frequency.value = currentPitch;
  osc2.frequency.value = currentPitch * 1.005;

  osc1.start(); osc2.start(); trill.start(); noise.start();

  voice = {
    osc1, osc2, trill, noise,
    amp, trem, body, f1, f2, f1g, f2g,
    noiseGain, trillToPitch, trillToAmp,
    basePitch: currentPitch
  };

  document.body.classList.add('playing');
  applyBreath();
}

function stopVoice(now = false) {
  if (!voice) return;
  const t = ctx.currentTime;
  const fade = now ? 0.02 : 0.18;
  voice.amp.gain.cancelScheduledValues(t);
  voice.amp.gain.setValueAtTime(voice.amp.gain.value, t);
  voice.amp.gain.exponentialRampToValueAtTime(0.0001, t + fade);
  voice.noiseGain.gain.linearRampToValueAtTime(0, t + fade);

  const v = voice;
  setTimeout(() => {
    try {
      v.osc1.stop(); v.osc2.stop(); v.trill.stop(); v.noise.stop();
      v.osc1.disconnect(); v.osc2.disconnect(); v.trill.disconnect(); v.noise.disconnect();
    } catch(e){}
  }, fade * 1000 + 40);

  voice = null;
  document.body.classList.remove('playing');
}

//──────────── THE COUPLING MATRIX ────────────
//   one input (breath) → many outputs, all gated through macros
//   this is the basis-change: the user feels ONE knob,
//   the synthesis hears SIX coordinated parameters
//─────────────────────────────────────────────
function applyBreath() {
  root.style.setProperty('--breath', breath);
  breathFill.style.height = (breath * 100) + '%';
  breathValueEl.textContent = breath.toFixed(2);

  if (!voice || !ctx) return;
  const t = ctx.currentTime;
  const e = macros.effort;
  const b = macros.body;
  const tr = macros.tract;
  const dr = macros.drift;
  const br = breath;

  // 1. amplitude — perceptual curve, scaled by effort
  const ampVal = Math.pow(br, 1.3) * (0.5 + e * 0.5);
  voice.amp.gain.setTargetAtTime(ampVal, t, 0.025);

  // 2. trill (warble) depth — more breath, more wobble
  voice.trillToPitch.gain.setTargetAtTime(br * e * 8, t, 0.04);
  voice.trillToAmp.gain.setTargetAtTime(br * e * 0.35, t, 0.04);

  // 3. trill rate — also rises a bit with breath, more with body
  voice.trill.frequency.setTargetAtTime(11 + br * 8 + b * 6, t, 0.05);

  // 4. tract formants — tract macro picks vowel, breath opens it
  const f1Base = 380 + tr * 700;          // 380 (oo) → 1080 (ah)
  const f2Base = 900 + tr * 1700;         // 900 → 2600
  voice.f1.frequency.setTargetAtTime(f1Base + br * 250, t, 0.03);
  voice.f2.frequency.setTargetAtTime(f2Base + br * 600, t, 0.03);

  // 5. body filter — opens with breath, scaled by effort, weighted by body
  const bodyCut = 280 + br * (1400 + e * 1800) * (0.6 + b * 0.8);
  voice.body.frequency.setTargetAtTime(bodyCut, t, 0.03);
  voice.body.Q.setTargetAtTime(0.8 + b * 2.4, t, 0.05);

  // 6. pitch sag (drift) — owls dip pitch as breath crests
  const sag = br * dr * (currentPitch * 0.06);
  voice.osc1.frequency.setTargetAtTime(currentPitch - sag, t, 0.06);
  voice.osc2.frequency.setTargetAtTime(currentPitch * 1.005 - sag, t, 0.06);

  // 7. breathiness — noise mix rises with breath, scaled by (1-body)
  const noiseAmt = br * (0.04 + (1 - b) * 0.12);
  voice.noiseGain.gain.setTargetAtTime(noiseAmt, t, 0.04);
}

//──────────── interactions ────────────
function attachDrag(el, onMove, onStart, onEnd) {
  let active = false;
  let startY = 0;
  let startVal = 0;

  function down(y) {
    active = true;
    startY = y;
    startVal = onStart();
    el.setPointerCapture && el.setPointerCapture(currentPointerId);
  }
  function move(y) {
    if (!active) return;
    const rect = el.getBoundingClientRect();
    const delta = (startY - y) / rect.height;
    onMove(Math.max(0, Math.min(1, startVal + delta)));
  }
  function up() {
    if (!active) return;
    active = false;
    onEnd && onEnd();
  }

  let currentPointerId = null;
  el.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    currentPointerId = e.pointerId;
    down(e.clientY);
  });
  el.addEventListener('pointermove', (e) => {
    if (!active) return;
    e.preventDefault();
    move(e.clientY);
  });
  el.addEventListener('pointerup', (e) => { up(); });
  el.addEventListener('pointercancel', (e) => { up(); });
  el.addEventListener('pointerleave', (e) => { up(); });
}

// — breath bar: direct touch sets breath, also gates the voice —
let breathPressed = false;
breathBar.addEventListener('pointerdown', (e) => {
  e.preventDefault();
  breathBar.setPointerCapture(e.pointerId);
  breathPressed = true;
  startVoice();
  setBreathFromEvent(e);
});
breathBar.addEventListener('pointermove', (e) => {
  if (!breathPressed) return;
  e.preventDefault();
  setBreathFromEvent(e);
});
function releaseBreath() {
  if (!breathPressed) return;
  breathPressed = false;
  // gentle ramp down
  const rampDown = () => {
    breath = Math.max(0, breath - 0.08);
    applyBreath();
    if (breath > 0.01) requestAnimationFrame(rampDown);
    else { breath = 0; applyBreath(); stopVoice(); }
  };
  rampDown();
}
breathBar.addEventListener('pointerup', releaseBreath);
breathBar.addEventListener('pointercancel', releaseBreath);
breathBar.addEventListener('pointerleave', releaseBreath);

function setBreathFromEvent(e) {
  const rect = breathBar.getBoundingClientRect();
  const y = e.clientY - rect.top;
  breath = Math.max(0, Math.min(1, 1 - (y / rect.height)));
  applyBreath();
}

// — macro knobs: drag vertically to set value —
document.querySelectorAll('.macro').forEach(el => {
  const name = el.dataset.macro;
  const valEl = el.querySelector('.macro-val');
  const arcFg = el.querySelector('.knob-arc-fg');

  function updateKnob() {
    const v = macros[name];
    valEl.textContent = v.toFixed(2);
    // arc length: dash 70 = full sweep
    arcFg.setAttribute('stroke-dasharray', `${(v * 70).toFixed(1)} 100`);
    root.style.setProperty('--' + name, v);
  }
  updateKnob();

  let active = false, startY = 0, startVal = 0;
  el.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    el.setPointerCapture(e.pointerId);
    active = true;
    startY = e.clientY;
    startVal = macros[name];
  });
  el.addEventListener('pointermove', (e) => {
    if (!active) return;
    e.preventDefault();
    const delta = (startY - e.clientY) / 140;
    macros[name] = Math.max(0, Math.min(1, startVal + delta));
    updateKnob();
    if (voice) applyBreath();
  });
  const end = () => { active = false; };
  el.addEventListener('pointerup', end);
  el.addEventListener('pointercancel', end);
});

// — pitch buttons —
document.querySelectorAll('.pitch').forEach(btn => {
  btn.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    document.querySelectorAll('.pitch').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentPitch = parseFloat(btn.dataset.freq);
    if (voice) {
      voice.basePitch = currentPitch;
      applyBreath();
    }
  });
});

// — preset name shimmer (decorative) —
const patches = ['TAWNY', 'BARRED', 'SCREECH', 'BURROWING', 'GREAT GREY'];
let patchIdx = 0;
document.getElementById('patchName').addEventListener('click', () => {
  patchIdx = (patchIdx + 1) % patches.length;
  document.getElementById('patchName').textContent = patches[patchIdx];
  // each patch is a different macro starting point — playful preset hint
  const presets = {
    TAWNY:     { effort: 0.7, body: 0.5, tract: 0.5, drift: 0.4 },
    BARRED:    { effort: 0.85, body: 0.7, tract: 0.35, drift: 0.6 },
    SCREECH:   { effort: 0.95, body: 0.3, tract: 0.85, drift: 0.7 },
    BURROWING: { effort: 0.5, body: 0.4, tract: 0.6, drift: 0.25 },
    'GREAT GREY': { effort: 0.6, body: 0.85, tract: 0.25, drift: 0.5 }
  };
  const p = presets[patches[patchIdx]];
  for (const k in p) macros[k] = p[k];
  // refresh knob UIs
  document.querySelectorAll('.macro').forEach(el => {
    const v = macros[el.dataset.macro];
    el.querySelector('.macro-val').textContent = v.toFixed(2);
    el.querySelector('.knob-arc-fg').setAttribute('stroke-dasharray', `${(v * 70).toFixed(1)} 100`);
    root.style.setProperty('--' + el.dataset.macro, v);
  });
  if (voice) applyBreath();
});

// init css vars
for (const k in macros) root.style.setProperty('--' + k, macros[k]);

</script>

